# ============================================================
# ABHAYA Platform — .gitignore
# ============================================================

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ── Build outputs ────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# ── Environment & secrets ────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
**/firebase-service-account.json
**/google-services.json
**/GoogleService-Info.plist

# ── Expo / React Native ──────────────────────────────────────
.expo/
.expo-shared/
mobile/.expo/
mobile/android/
mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ── TypeScript ───────────────────────────────────────────────
*.js.map
*.d.ts.map

# ── Python (future ML layer) ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
*.egg
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
lerna-debug.log*

# ── Databases / dumps ────────────────────────────────────────
*.sql.bak
*.dump
*.db
*.sqlite
*.sqlite3

# ── Testing ──────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# ── IDE & Editor ─────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store

# ── OS ───────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.AppleDouble
.LSOverride
._*

# ── Uploads / media ──────────────────────────────────────────
backend/uploads/
backend/tmp/

# ── Misc ─────────────────────────────────────────────────────
*.tgz
*.zip
.turbo/
