# ============================================================
# ABHAYA Platform — Root Environment Example
# ============================================================
# This file documents the environment variables for all
# sub-projects. Each sub-project also has its own .env.example.
#
# USAGE:
#   Copy backend/.env.example  → backend/.env
#   Copy admin/.env.example    → admin/.env
#   Edit each file with real values before starting services.
#
# See docs/setup-guide.md for step-by-step configuration help.
# ============================================================

# ── BACKEND (backend/.env) ───────────────────────────────────
# PORT=5000
# NODE_ENV=development
# DATABASE_URL=postgresql://postgres:password@localhost:5432/abhaya_db
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=your_super_secret_jwt_key_change_in_production
# JWT_EXPIRES_IN=7d
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# SMS_PROVIDER=demo
# FRONTEND_URL=http://localhost:19006
# CORS_ORIGINS=http://localhost:19006,http://localhost:3001
# DEMO_MODE=true

# ── ADMIN PANEL (admin/.env) ─────────────────────────────────
# VITE_API_BASE_URL=http://localhost:5000/api

# ── MOBILE (mobile/.env or app.config.js extra) ─────────────
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
